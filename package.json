{
  "name": "ablespace-assessment",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@ablespace/web",
    "dev:api": "npm run start:dev --workspace=@ablespace/api",
    "build": "npm run build --workspace=@ablespace/api && npm run build --workspace=@ablespace/web",
    "test": "npm run test --workspace=@ablespace/api"
  },
  "engines": {
    "node": ">=20"
  }
}
